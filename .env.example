# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ UTV MEDIA (ШАБЛОН ДЛЯ РАЗВЕРТЫВАНИЯ НА СЕРВЕРЕ И ЛОКАЛЬНО)
# ==============================================================================

# 1. Строка подключения к базе данных PostgreSQL (Prisma ORM)
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/utv_catalog?schema=public"

# 2. Учетная запись администратора
ADMIN_EMAIL=admin@utvmedia.ru
ADMIN_PASSWORD=change_this_secure_password_on_server
SESSION_SECRET=generate_random_long_secret_key_utv_2026

# 3. Уведомления в Telegram-бот (необязательно)
# Создайте бота в @BotFather, получите токен и ID чата через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Email-уведомления администратора (необязательно)
ADMIN_NOTIFICATION_EMAIL=orders@utvmedia.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
