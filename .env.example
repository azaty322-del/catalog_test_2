# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ UTV MEDIA (ШАБЛОН ДЛЯ РАЗВЕРТЫВАНИЯ)
# Скопируйте этот файл в .env.local для локальной работы или настройте на сервере.
# ==============================================================================

# 1. Учетная запись администратора
ADMIN_EMAIL=admin@utvmedia.ru
ADMIN_PASSWORD=change_this_secure_password_on_server
SESSION_SECRET=generate_random_long_secret_string

# 2. Уведомления в Telegram-бот (необязательно)
# Создайте бота в @BotFather, получите токен и ID чата через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Email-уведомления администратора (необязательно)
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
