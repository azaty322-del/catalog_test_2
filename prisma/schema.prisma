datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. КАРТОЧКИ КОНТЕНТА (ТАЙТЛЫ КАТАЛОГА)
// ==============================================================================
model Movie {
  id                   String   @id @default(cuid())
  catalogId            String?  // Буквенно-цифровой шифр из документа (A1, B2, C1, etc.)
  slug                 String   @unique
  titleRu              String
  titleEn              String
  descriptionRu        String   @default("")
  descriptionEn        String   @default("")
  category             String   // Русское название категории
  categorySlug         String   // Слаг (nature, travel, culinary, etc.)
  episodesCount        Int      @default(1)
  episodeDuration      String?  // Хрон одного эпизода (например: "15-23" или "30")
  duration             String   @default("30 мин") // Отображаемая длительность ("03:48:55", "30 мин")
  totalDurationMinutes Int      @default(30)
  quality              String   @default("HD / 4K")
  qualities            String[] @default(["HD", "4K"])
  country              String   @default("Россия")
  countries            String[] @default(["Россия"])
  year                 Int      @default(2024)
  yearRange            String?  // Диапазон лет ("2020-2024", "2023-2026")
  languages            String[] @default(["Русский"])
  author               String?  // Автор / студия / режиссер ("Kitchen TV", "Игорь Фалелюхин")
  ageRating            String   @default("12+")
  trailerUrl           String   @default("") // Ссылка на видео (YouTube, Rutube, VK Video, Яндекс Диск)
  territory            String   @default("Весь мир")
  rightsPeriod         String   @default("До 31.12.2028")
  tags                 String[] @default([])
  poster               String   @default("")
  stills               String[] @default([])
  status               String   @default("Опубликован") // Опубликован / Черновик
  views                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([categorySlug])
  @@index([catalogId])
  @@index([status])
}

// ==============================================================================
// 2. ПОЛЬЗОВАТЕЛИ И АВТОРИЗАЦИЯ
// ==============================================================================
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // Хеш пароля (PBKDF2)
  salt      String    @default("")
  fullName  String
  role      String    @default("USER") // ADMIN, USER, MANAGER
  company   String?
  position  String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@index([email])
  @@index([role])
}

// Сессии пользователей
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ==============================================================================
// 3. ЗАКАЗЫ И КОРЗИНА
// ==============================================================================
model Order {
  id         String      @id // ORD-XXXXXX
  fullName   String
  email      String
  phone      String
  company    String?
  comment    String?
  status     String      @default("new") // new, processing, completed, cancelled
  totalCount Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([status])
  @@index([createdAt])
}

// Позиции в заказе
model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  movieId              String
  title                String
  poster               String?
  category             String?
  qualities            String[] @default([])
  totalDurationMinutes Int?

  @@index([orderId])
}

// ==============================================================================
// 4. ЖУРНАЛ АУДИТА И БЕЗОПАСНОСТИ
// ==============================================================================
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   @default("INFO") // INFO, WARN, ERROR, SECURITY
  action    String   // MOVIE_UPDATE, LOGIN, ORDER_CREATE, EXCEL_IMPORT, etc.
  actor     String?  // Email пользователя, IP или SYSTEM
  details   String?  // JSON-текст с подробностями
  ip        String?

  @@index([level])
  @@index([action])
  @@index([timestamp])
}

// ==============================================================================
// 5. НАСТРОЙКИ СИСТЕМЫ
// ==============================================================================
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
